{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "vercel",
  "functions": {
    "api/index.py": {
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/dashboard",
      "destination": "/dashboard/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index?__p=:path*"
    },
    {
      "source": "/(.*)",
      "destination": "https://halcyonvector.github.io/Cricket-Intelligence-Lab/$1"
    }
  ]
}
