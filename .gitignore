# Large raw inputs & generated DB (exceed GitHub's 100 MB per-file limit)
*.zip
*.zip.tmp
*.db
*.db-wal
*.db-shm
cil.db.building*
.build.lock

# Superseded monolithic bundle (replaced by cohorts/*.js + index.js)
web/dashboard/data.js

# API-only per-cohort JSON; regenerate with scripts/build_all.py
web/data/

# Local server runtime cache (photo URLs etc., created by serve.py)
.cache/

# Scraper diagnostic dumps (fetch_icc_rankings.py --debug, Cricbuzz probes)
scripts/_debug_*.html
scripts/_cb_*.html
probe_output.txt

# Local secrets / personal tool config
.env
.env.*
.claude/
.vscode/
.idea/

# Python / OS / editor junk
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
*.tmp
*.xlsx
.fuse_hidden*
.DS_Store
Thumbs.db

# Generated site data: built weekly by .github/workflows/site.yml and published as the
# data-latest release asset (not committed, so git history stops growing every week).
# Get it locally with: python scripts/fetch_data.py
web/dashboard/index.js
web/dashboard/rankings.js
web/dashboard/players.js
web/dashboard/cohorts/
web/dashboard/careers/
# Pages deploy writes these
web/index.html
web/.nojekyll

.vercel
